# content-agent — exemplo de variáveis (SOMENTE NOMES, nunca valores reais)
# As chaves de provedor usam os nomes OFICIAIS que o entrypoint do Hermes reconhece.

# --- Telegram (nativo do Hermes) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
TELEGRAM_HOME_CHANNEL=
# TELEGRAM_CRON_THREAD_ID=

# --- Provedores de LLM (grátis-primeiro; preencher só os que existirem) ---
OPENROUTER_API_KEY=
# LLM_MODEL define o modelo padrão (ex.: nvidia/nemotron-3.5-lightning:free)
LLM_MODEL=
# HERMES_INFERENCE_PROVIDER=
# DASHSCOPE_API_KEY=   # Qwen via Alibaba Model Studio
# NVIDIA / outros conforme forem validados no ambiente real

# --- Voz / mídia ---
# TTS padrão = Edge TTS (grátis, precisa ffmpeg). STT padrão = faster-whisper local.
# ELEVENLABS_API_KEY=
# VOICE_TOOLS_OPENAI_KEY=

# --- Projeto (content-agent) ---
PROJECT_TIMEZONE=America/Fortaleza
CONTENT_DB_PATH=/data/content-agent/db/content.db
ARTIFACTS_PATH=/data/content-agent/artifacts
MONTHLY_BUDGET_BRL=200
FLOW_REWORK_RESERVE_PERCENT=20
MAX_AUTOMATIC_REVISIONS=2
